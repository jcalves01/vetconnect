# ============================================================================
# VetConnect — environment variables
# Copy this file to `.env.local` for local development (never commit .env.local).
# On Vercel, set these under Project → Settings → Environment Variables.
# ============================================================================

# REQUIRED — your Anthropic API key. Lives ONLY on the server, never shipped
# to the browser. Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OPTIONAL — override the model. Defaults to claude-sonnet-4-5 if unset.
# Use a model your account has access to.
# ANTHROPIC_MODEL=claude-sonnet-4-5
