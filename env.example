# Copie este ficheiro para .env.local e preencha os valores
# NUNCA faça commit do .env.local para o repositório

# Anthropic API Key — obtenha em https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
# ANTHROPIC_MODEL=claude-sonnet-4-6

# Diagnóstico Diferencial por IA (api/diagnosis.js) — as três seguintes são
# opcionais; só é preciso preencher as dos modelos que quiseres disponibilizar
# no seletor "Modelo IA". Sem chave, esse provider falha só quando escolhido.
# GEMINI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
# GEMINI_MODEL=gemini-2.0-flash
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# OPENAI_MODEL=gpt-4o
# DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# DEEPSEEK_MODEL=deepseek-chat

# Opcional: restringir origens permitidas (recomendado em produção)
# ALLOWED_ORIGIN=https://vetconnect.pt

# Supabase — Project Settings → API no dashboard do teu projecto
# A anon key é segura para expor no browser (acesso controlado por RLS)
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
